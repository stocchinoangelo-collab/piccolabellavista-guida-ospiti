# Copy as .htaccess only after configuring the absolute password file path.
Options -Indexes
AuthType Basic
AuthName "Piccolabellavista ospiti"
AuthUserFile /ABSOLUTE/PATH/OUTSIDE/WEBROOT/.htpasswd
Require valid-user
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
# Enable HTTPS enforcement and HSTS only after TLS/domain configuration.
